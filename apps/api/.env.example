# ─────────────────────────────────────────────────────────────────────────────
# ProjectHub API — Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# In production, all variables marked REQUIRED must be set or the app will
# refuse to start.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development        # development | production
PORT=4000
FRONTEND_URL=http://localhost:3000   # REQUIRED in production — e.g. https://app.yourdomain.com

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# REQUIRED — Pooled connection URL (used by the running app)
DATABASE_URL="postgresql://neondb_owner:<DB_PASSWORD>@ep-fragrant-butterfly-aozxkmtq-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct (unpooled) URL — used ONLY by Prisma CLI for migrations
# If not set, DATABASE_URL is used (fine for single-instance dev)
DIRECT_URL="postgresql://neondb_owner:<DB_PASSWORD>@ep-fragrant-butterfly-aozxkmtq.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── JWT — REQUIRED in production ──────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="zpr2UkqxCOeZrAghwfOdW3vS7Lqy1r6aAStI3Z7/SGArf9k6ZQMrTAENhvuwSj8Y"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="SJ+Ea+FJpACHx4NTcTc+wWWhdX1NX7Rdogaqz2oO45tyRQ07oyiXMhhH7xlZwPvQ"
JWT_REFRESH_EXPIRES_IN="7d"
