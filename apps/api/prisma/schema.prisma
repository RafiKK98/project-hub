// This is your Prisma schema file.
// Learn more about it at: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  // output   = "../src/lib/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  // Pooled connection — used by the application at runtime
  // url      = env("DATABASE_URL")
  // Direct connection — used by Prisma CLI for migrations
  // directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Models are added incrementally per milestone.
// Phase 2 adds: User, RefreshToken, VerificationToken

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatarUrl     String?
  role          UserRole @default(USER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts           Account[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@index([email])
  @@map("users")
}

/// Stores credentials per provider (local, google, github).
/// A user can have multiple accounts (one per provider).
model Account {
  id                String    @id @default(cuid())
  userId            String
  provider          String // "local" | "google" | "github"
  providerAccountId String // email for local, OAuth sub for providers
  passwordHash      String? // only set for provider = "local"
  accessToken       String? // OAuth access token (encrypted at rest in Phase 15)
  refreshToken      String? // OAuth refresh token
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Hashed refresh tokens with rotation support.
/// On each token refresh, the old record is deleted and a new one is created.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // bcrypt hash of the raw token
  family    String // rotation family — reuse of a revoked family = breach detected
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

/// Tokens for email verification and password reset.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

